<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project name="Build YT" default="deploy">
	<!-- every property in one place, so install_local can stage the app
	     without dragging in the packaging targets -->
	<target name="init">
    	<property file="build.properties"/>
		<property name="stage" value="stage"/>
		<property name="rootDir" value="${stage}/ytdownloader"/>
		<property name="icons" value="${rootDir}/icons"/>
		<property name="aurTarget" value="AUR"/>
		<property name="debTarget" value="DEB"/>
		<property name="ubu1Build" value="ytdownloader_${version}+${pkgrelease}~${ubu0}"/>
		<property name="ubu2Build" value="ytdownloader_${version}+${pkgrelease}~${ubu1}"/>
		<property name="ubu3Build" value="ytdownloader_${version}+${pkgrelease}~${ubu2}"/>
		<property name="ubu1Target" value="${stage}/${ubu1Build}"/>
		<property name="ubu2Target" value="${stage}/${ubu2Build}"/>
		<property name="ubu3Target" value="${stage}/${ubu3Build}"/>
		<property name="source" value="../src"/>
		<property name="aurSource" value="AUR-template"/>
		<property name="srcIcons" value="${source}/icons"/>
		<!-- Shared code, VideoCut holds the master. Deliberately not copied
		     into our src - it is vendored in here at build time, so it can
		     never drift apart from VideoCut's. Same as VideoMerge does it. -->
		<property name="ffmpegTools" value="../../VideoCut/src/FFMPEGTools.py"/>
		<!-- a fileset matching nothing copies nothing without complaining, so
		     the package would silently ship without it and die on the user's
		     machine with an ImportError. Stop here instead. -->
		<available file="${ffmpegTools}" property="ffmpegTools.present"/>
		<fail unless="ffmpegTools.present">
FFMPEGTools.py not found at ${ffmpegTools}
The shared code lives in VideoCut, which has to be checked out next to this
project (same parent directory). Nothing can be built without it.
		</fail>
	</target>

	<!-- everything that goes into the package, staged in ${rootDir} -->
	<target name="stage_app" depends="init">
		<delete dir="${stage}"/>
		<mkdir dir="${stage}"/>
		<mkdir dir="${rootDir}"/>
		<mkdir dir="${icons}"/>

		<!-- get currentt yt-dlp via wget or curl -->
		<exec dir="." executable="/bin/bash" os="Linux">
		 <arg value="updateYtdl.sh"/>
		</exec>


		<copy todir="${rootDir}">
			<fileset file="*.desktop">
			</fileset>
			<fileset file="*install*.sh">
			</fileset>
			<fileset file="yt-dlp">
			</fileset>
			<fileset file="${ffmpegTools}">
			</fileset>
		</copy>
			
		<chmod file="${rootDir}/install.sh" perm="ug+rwx"/>
		<chmod file="${rootDir}/uninstall.sh" perm="ug+rwx"/>

		<copy todir="${icons}">
			<fileset dir="${srcIcons}">
			</fileset>
		</copy>

		<copy todir="${rootDir}">
			<fileset file="${source}/YtGui.py"/>
				<filterset>
			    	<filter token="xxxx" value="${version}"/>
			  	</filterset>			
		</copy>
		<copy todir="${rootDir}">
			<fileset dir="${source}" includes="*.png"></fileset>
			<fileset file="${source}/YtModel.py"/>
		</copy>
	</target>

	<!-- the staged app plus the empty output dirs the packaging needs -->
	<target name="build_dir" depends="stage_app">
		<delete dir="${aurTarget}"/>
		<delete dir="${debTarget}"/>
		<mkdir dir="${aurTarget}"/>
		<mkdir dir="${debTarget}"/>
		<mkdir dir="${ubu1Target}"/>
		<mkdir dir="${ubu2Target}"/>
		<mkdir dir="${ubu3Target}"/>
	</target>

	<!-- Install the staged build into /opt/ytdownloader for local testing.
	     Runs the very install.sh that ships in the tar, so what gets tested
	     is the real install path, not a copy of it. Leaves AUR/ and DEB/
	     alone - a test install must not eat the release artifacts. -->
	<target name="install_local" depends="stage_app"
	        description="install into /opt/ytdownloader for testing (needs root)">
		<!-- absolute: pkexec resets PATH and does not promise to keep the
		     working directory -->
		<property name="rootDirAbs" location="${rootDir}"/>
		<echo message="installing ${rootDirAbs} into /opt/ytdownloader"/>
		<exec executable="pkexec" failonerror="true">
			<arg value="/bin/bash"/>
			<arg value="${rootDirAbs}/install.sh"/>
		</exec>
	</target>

	<target name="deploy" depends="build_dir">
		<delete>
			<fileset dir="." includes="**/*.tar*"/>
		</delete>	
		<exec executable="tar" output="/dev/null" os="Linux">
			<arg value="-cp"/>
			<arg value="--file=ytdownloader${version}.tar"/>
			<arg value="--directory=${stage}"/>
			<arg value="ytdownloader"/>
		</exec>
		
		<!-- PKBUILD -->
		<checksum file="ytdownloader${version}.tar" algorithm="SHA-256" property="aurSHA256"/>
		<copy todir="${aurTarget}">
			<fileset file="${aurSource}/*"/>
			<filterset>
				<filter token="sha256sum" value="${aurSHA256}"/>
				<filter token="xxx" value="${version}"/>
				<filter token="xpkgrelx" value="${pkgrelease}"/>
			</filterset>
		</copy>		
		<exec dir="${aurTarget}" executable="makepkg" output="${aurTarget}/.SRCINFO" os="Linux">
		 <arg value="--printsrcinfo"/> 
		</exec>

		<tstamp>
    	 	<format property="time.stamp" pattern="EEE, d LLL yyyy HH:mm:ss"/>
		</tstamp>

		<!-- latest changelog entries, plain bullet lines, see changes.txt -->
		<loadfile property="changes" srcFile="changes.txt"/>

		<!-- DEBBUILD ubu1-->
		<copy todir="${ubu1Target}">
			<fileset dir="DEB-template"/>
			<filterset>
				<filter token="ubu" value="${ubu0}"/>
				<filter token="xxx" value="${version}"/>
				<filter token="xpkgrelx" value="${pkgrelease}"/>
				<filter token="xtsx" value="${time.stamp}"/>
				<filter token="changes" value="${changes}"/>
			</filterset>
		</copy>

		<mkdir dir="${ubu1Target}/addons"/>
		<mkdir dir="${ubu1Target}/debian"/>
		<mkdir dir="${ubu1Target}/opt"/>
		<copy todir="${ubu1Target}/opt">
			<fileset file="${source}/*.py" />
			<filterset>
			    <filter token="xxxx" value="${version}"/>
			</filterset>
		</copy>

	   <copy todir="${ubu1Target}/opt">
  		   <fileset file="${source}/*.png"/>
		   <fileset file="${rootDir}/FFMPEGTools.py"/>
		</copy>
		<copy todir="${ubu1Target}/opt/icons">
			<fileset dir="${srcIcons}">
			</fileset>
		</copy>	
		<copy todir="${ubu1Target}/addons">
			<fileset file="*.desktop"/>
			<fileset file="yt-dlp"/>
		</copy>
		<chmod file="${ubu1Target}/opt/YtGui.py" perm="ug+rwx"/>
		<chmod file="${ubu1Target}/addons/yt-dlp" perm="ug+rwx"/>
		<exec executable="tar" output="/dev/null" os="Linux">
			<arg value="-cp"/>
			<arg value="--file=${debTarget}/${ubu1Build}.tar"/>
			<arg value="--directory=${stage}"/>
			<arg value="${ubu1Build}"/>
		</exec>
		

		<!-- DEBBUILD ubu2-->
		<copy todir="${ubu2Target}">
			<fileset dir="DEB-template"/>
			<filterset>
				<filter token="ubu" value="${ubu1}"/>
				<filter token="xxx" value="${version}"/>
				<filter token="xpkgrelx" value="${pkgrelease}"/>
				<filter token="xtsx" value="${time.stamp}"/>
				<filter token="changes" value="${changes}"/>
			</filterset>
		</copy>
		<mkdir dir="${ubu2Target}/addons"/>
		<mkdir dir="${ubu2Target}/debian"/>
		<mkdir dir="${ubu2Target}/opt"/>
		<copy todir="${ubu2Target}/opt">
			<fileset file="${source}/*.py" />
			<filterset>
			    <filter token="xxxx" value="${version}"/>
			</filterset>
		</copy>
		<copy todir="${ubu2Target}/opt">
  		   <fileset file="${source}/*.png"/>
		   <fileset file="${rootDir}/FFMPEGTools.py"/>
		</copy>
		<copy todir="${ubu2Target}/opt/icons">
			<fileset dir="${srcIcons}">
			</fileset>
		</copy>	
		<copy todir="${ubu2Target}/addons">
			<fileset file="*.desktop"/>
			<fileset file="yt-dlp"/>
		</copy>
		<chmod file="${ubu2Target}/opt/YtGui.py" perm="ug+rwx"/>
		<chmod file="${ubu2Target}/addons/yt-dlp" perm="ug+rwx"/>
		<exec executable="tar" output="/dev/null" os="Linux">
			<arg value="-cp"/>
			<arg value="--file=${debTarget}/${ubu2Build}.tar"/>
			<arg value="--directory=${stage}"/>
			<arg value="${ubu2Build}"/>
		</exec>	
		
		<!-- DEBBUILD ubu3-->
		<copy todir="${ubu3Target}">
			<fileset dir="DEB-template"/>
			<filterset>
				<filter token="ubu" value="${ubu2}"/>
				<filter token="xxx" value="${version}"/>
				<filter token="xpkgrelx" value="${pkgrelease}"/>
				<filter token="xtsx" value="${time.stamp}"/>
				<filter token="changes" value="${changes}"/>
			</filterset>
		</copy>
		
		<mkdir dir="${ubu3Target}/addons"/>
		<mkdir dir="${ubu3Target}/debian"/>
		<mkdir dir="${ubu3Target}/opt"/>
		<copy todir="${ubu3Target}/opt">
			<fileset file="${source}/*.py" />
			<filterset>
			    <filter token="xxxx" value="${version}"/>
			</filterset>
		</copy>

	   <copy todir="${ubu3Target}/opt">
  		   <fileset file="${source}/*.png"/>
		   <fileset file="${rootDir}/FFMPEGTools.py"/>
		</copy>
		<copy todir="${ubu3Target}/opt/icons">
			<fileset dir="${srcIcons}">
			</fileset>
		</copy>	
		<copy todir="${ubu3Target}/addons">
			<fileset file="*.desktop"/>
			<fileset file="yt-dlp"/>
		</copy>
		<chmod file="${ubu3Target}/opt/YtGui.py" perm="ug+rwx"/>
		<chmod file="${ubu3Target}/addons/yt-dlp" perm="ug+rwx"/>
		<exec executable="tar" output="/dev/null" os="Linux">
			<arg value="-cp"/>
			<arg value="--file=${debTarget}/${ubu3Build}.tar"/>
			<arg value="--directory=${stage}"/>
			<arg value="${ubu3Build}"/>
		</exec>		
		
		<delete dir="${stage}"/>
	</target>
</project>	